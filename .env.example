# Supabase Cloud PostgreSQL Connection String
# Copy the exact URI from Supabase Dashboard > Connect > Session pooler (port 5432).
# Replace the password placeholder with your URL-encoded database password.
# Do not use a Supabase API URL, anon key, or service-role key here.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres

# Server Port (Optional, default 3000)
PORT=3000

# Set a long unique password before starting the server.
ADMIN_PASSWORD=
# Set NODE_ENV=production when serving through HTTPS.
# Set TRUST_PROXY=1 only behind one trusted HTTPS reverse proxy.
TRUST_PROXY=0

# Add later: international WhatsApp number, e.g. 94771234567 (no leading local 0).
WHATSAPP_NUMBER=
# Public HTTPS website address; used in staff review links. Use localhost only for local tests.
PUBLIC_BASE_URL=http://localhost:3000
# Optional public contact details and the hotel's exact HTTPS map pin.
PUBLIC_ADDRESS=Above Gregory Lake, Nuwara Eliya, Sri Lanka.
PUBLIC_PHONE=
PUBLIC_EMAIL=
PUBLIC_MAP_URL=
# Keep consistent with existing room prices. Default is USD.
CURRENCY=USD

# Bank transfer: staff send these details to guests on WhatsApp.
# Keep currency consistent with existing room prices; changing it does not convert prices.
ADVANCE_PERCENT=30
BANK_NAME=
BANK_BRANCH=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# Optional automatic staff email via Resend. Set these only when ready to send real emails.
# NOTIFICATION_FROM must use a sender/domain verified with Resend.
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_TO=
